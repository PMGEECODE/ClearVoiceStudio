{
  "name": "clearvoice-studio",
  "version": "0.1.37",
  "private": true,
  "description": "Desktop studio for Neural Text-to-Speech synthesis",
  "author": "LiveCodeTech <dev@livecodetech.local>",
  "homepage": "https://github.com/PMGEECODE/ClearVoiceStudio",
  "repository": {
    "type": "git",
    "url": "https://github.com/PMGEECODE/ClearVoiceStudio.git"
  },
  "bugs": {
    "url": "https://github.com/PMGEECODE/ClearVoiceStudio/issues"
  },
  "desktopName": "clearvoice-studio.desktop",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "test:emotion": "node --no-warnings --experimental-strip-types src/lib/emotion-tts/index.test.ts",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "node scripts/electron-build.mjs",
    "electron:build:linux": "node scripts/electron-build.mjs --linux",
    "electron:build:win": "node scripts/electron-build.mjs --win",
    "bundle:models": "node scripts/bundle-whisper.mjs",
    "setup:ffmpeg-win": "node scripts/download-ffmpeg-win.mjs",
    "setup:swc-win": "node scripts/download-swc-win.mjs",
    "setup:win": "node scripts/download-ffmpeg-win.mjs && node scripts/download-swc-win.mjs",
    "postinstall": "node scripts/patch-transformers.mjs",
    "build:desktop:linux": "node scripts/electron-build.mjs --linux",
    "build:desktop:win": "node scripts/electron-build.mjs --win",
    "build:desktop": "node scripts/electron-build.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "onnxruntime-common": "1.21.0",
    "onnxruntime-node": "1.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.3.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  },
  "overrides": {
    "onnxruntime-node": "1.21.0",
    "onnxruntime-common": "1.21.0",
    "onnxruntime-web": "1.14.0"
  }
}
